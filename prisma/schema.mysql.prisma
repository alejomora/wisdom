generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER & AUTH
// ============================================

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  avatar          String    @default("🎯")
  frame           String    @default("")
  title           String    @default("Beginner")
  password        String
  role            String    @default("user") // user | admin
  xp              Int       @default(0)
  coins           Int       @default(0)
  totalStars      Int       @default(0)
  level           Int       @default(1) // user level based on XP
  lives           Int       @default(5)
  maxLives        Int       @default(5)
  livesLastRefill DateTime  @default(now())
  streak          Int       @default(0)
  longestStreak   Int       @default(0)
  lastActiveDate  String    @default("") // YYYY-MM-DD
  wordsLearned    Int       @default(0)
  exercisesDone   Int       @default(0)
  totalStudyTime  Int       @default(0) // minutes
  accuracy        Float     @default(0)
  listeningScore  Float     @default(0)
  writingScore    Float     @default(0)
  speakingScore   Float     @default(0)
  currentLevelId  String    @default("basic")
  theme           String    @default("default")
  energy          Int       @default(200)
  energyLastRefill DateTime  @default(now())
  challengeWins   Int       @default(0)
  challengeLosses Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  progress             UserProgress[]
  achievements         UserAchievement[]
  missions             UserMission[]
  rankingEntries        Ranking[]
  notifications         Notification[]
  challengerChallenges  Challenge[]     @relation("ChallengerChallenges")
  challengedChallenges  Challenge[]     @relation("ChallengedChallenges")
  wonChallenges         Challenge[]     @relation("ChallengeWins")
  challengeAttempts     ChallengeAttempt[]
}

// ============================================
// LEVELS & SCENARIOS
// ============================================

model Level {
  id            String     @id @default(cuid())
  slug          String     @unique // basic | intermediate | advanced
  name          String
  nameEs        String
  description   String     @db.Text
  descriptionEs String     @db.Text
  icon          String
  color         String
  order         Int
  minXp         Int        @default(0)
  scenarios     Scenario[]
  exams         Exam[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Scenario {
  id            String   @id @default(cuid())
  levelId       String
  slug          String
  name          String
  nameEs        String
  description   String   @db.Text
  descriptionEs String   @db.Text
  icon          String
  image         String   @default("")
  difficulty    Int      @default(1) // 1-5
  xpReward      Int      @default(50)
  order         Int
  isStarter     Boolean  @default(false) // first scenario unlocked by default
  type          String   @default("lesson") // lesson | challenge | energy | reading_follow
  level         Level    @relation(fields: [levelId], references: [id])
  lessons       Lesson[]
  progress      UserProgress[]
  challenges    Challenge[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([levelId, slug])
}

// ============================================
// LESSONS & QUESTIONS
// ============================================

model Lesson {
  id            String    @id @default(cuid())
  scenarioId    String
  title         String
  titleEs       String
  description   String    @db.Text
  descriptionEs String    @db.Text
  type          String    // vocabulary | grammar | listening | speaking | conversation | reading
  order         Int
  xpReward      Int       @default(10)
  scenario      Scenario  @relation(fields: [scenarioId], references: [id])
  questions     Question[]
  progress      UserProgress[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Question {
  id            String   @id @default(cuid())
  lessonId      String
  type          String   // multiple_choice | fill_blank | listen_write | order_words | match_concepts | pronunciation | translate | choose_image | build_sentence | find_error | dictation | flashcard
  prompt        String   @db.Text // The question text in English
  promptEs      String   @db.Text // Spanish hint/translation
  hintEn        String   @db.Text // Hint in English
  hintEs        String   @db.Text // Hint in Spanish
  audioText     String   @db.Text // Text to speak via TTS
  options       String   @db.Text // JSON array of options
  correctAnswer String   @db.Text // The correct answer
  explanation   String   @db.Text // Why this is correct
  explanationEs String   @db.Text // Explanation in Spanish
  image         String   @default("")
  points        Int      @default(10)
  order         Int
  lesson        Lesson   @relation(fields: [lessonId], references: [id])
  answers       UserAnswer[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================
// EXAMS
// ============================================

model Exam {
  id            String    @id @default(cuid())
  levelId       String
  type         String    // midterm | final
  title        String
  titleEs      String
  description  String    @db.Text
  descriptionEs String   @db.Text
  minScore     Float     @default(0.9) // 90% to pass
  questions    String    @db.LongText // JSON array of question data — can be very long
  level        Level     @relation(fields: [levelId], references: [id])
  results      ExamResult[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model ExamResult {
  id        String   @id @default(cuid())
  examId    String
  userId    String
  score     Float
  passed    Boolean
  answers   String   @db.LongText // JSON — can be very long
  exam      Exam     @relation(fields: [examId], references: [id])
  createdAt DateTime @default(now())
}

// ============================================
// USER PROGRESS
// ============================================

model UserProgress {
  id          String    @id @default(cuid())
  userId      String
  scenarioId  String?
  lessonId    String?
  status      String    @default("locked") // locked | unlocked | in_progress | completed
  progress    Float     @default(0) // 0-100
  stars       Int       @default(0) // 0-3
  xpEarned    Int       @default(0)
  completedAt DateTime?
  user        User      @relation(fields: [userId], references: [id])
  scenario    Scenario? @relation(fields: [scenarioId], references: [id])
  lesson      Lesson?   @relation(fields: [lessonId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, scenarioId])
  @@unique([userId, lessonId])
}

model UserAnswer {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  answer     String   @db.Text // User's answer can be long (sentences)
  isCorrect  Boolean
  timeTaken  Int      @default(0) // ms
  question   Question @relation(fields: [questionId], references: [id])
  createdAt  DateTime @default(now())
}

// ============================================
// GAMIFICATION
// ============================================

model Achievement {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  nameEs        String
  description   String   @db.Text
  descriptionEs String   @db.Text
  icon          String
  category      String   // streak | xp | exercises | scenarios | special
  requirement   Int      @default(1)
  reward        Int      @default(0) // coins
  users         UserAchievement[]
  createdAt     DateTime @default(now())
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id])
  achievement   Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
}

model Mission {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  titleEs       String
  description   String   @db.Text
  descriptionEs String   @db.Text
  type          String   // daily | weekly | special
  category      String   // exercises | pronunciation | streak | xp | scenarios
  requirement   Int
  rewardXp      Int      @default(0)
  rewardCoins   Int      @default(0)
  icon          String
  startDate     String   @default("") // YYYY-MM-DD or empty for recurring
  endDate       String   @default("")
  users         UserMission[]
  createdAt     DateTime @default(now())
}

model UserMission {
  id        String   @id @default(cuid())
  userId    String
  missionId String
  progress  Int      @default(0)
  completed Boolean  @default(false)
  claimed   Boolean  @default(false)
  date      String   // YYYY-MM-DD to track daily instances
  user      User     @relation(fields: [userId], references: [id])
  mission   Mission  @relation(fields: [missionId], references: [id])

  @@unique([userId, missionId, date])
}

// ============================================
// RANKINGS
// ============================================

model Ranking {
  id        String   @id @default(cuid())
  userId    String
  type      String   // global | weekly | monthly
  period    String   @default("") // YYYY-WXX or YYYY-MM
  xp        Int      @default(0)
  rank      Int      @default(0)
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, type, period])
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // achievement | level_up | streak | mission | event | system
  title     String
  message   String   @db.Text
  icon      String   @default("🔔")
  read      Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

// ============================================
// REWARDS SHOP
// ============================================

model Reward {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  nameEs        String
  description   String   @db.Text
  descriptionEs String   @db.Text
  type          String   // avatar | frame | title | skin | theme
  icon          String
  cost          Int      // coins
  rarity        String   @default("common") // common | rare | epic | legendary
  available     Boolean  @default(true)
  users         UserReward[]
  createdAt     DateTime @default(now())
}

model UserReward {
  id        String   @id @default(cuid())
  userId    String
  rewardId  String
  reward    Reward   @relation(fields: [rewardId], references: [id])
  equipped  Boolean  @default(false)
  purchased DateTime @default(now())

  @@unique([userId, rewardId])
}

// ============================================
// CHALLENGES (PvP)
// ============================================

model Challenge {
  id           String   @id @default(cuid())
  challengerId String
  challengedId String?  // null means open to anyone
  scenarioId   String
  entryFee     Int      @default(1500)
  pot          Int      @default(3000)
  status       String   @default("pending") // pending | active | completed | expired
  winnerId     String?
  expiresAt    DateTime
  challenger   User     @relation("ChallengerChallenges", fields: [challengerId], references: [id])
  challenged   User?    @relation("ChallengedChallenges", fields: [challengedId], references: [id])
  winner       User?    @relation("ChallengeWins", fields: [winnerId], references: [id])
  scenario     Scenario @relation(fields: [scenarioId], references: [id])
  attempts     ChallengeAttempt[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ChallengeAttempt {
  id              String    @id @default(cuid())
  challengeId     String
  userId          String
  correctAnswers  Int       @default(0)
  totalQuestions  Int       @default(0)
  timeTaken       Int       @default(0) // seconds
  score           Float     @default(0)
  completedAt     DateTime  @default(now())
  challenge       Challenge @relation(fields: [challengeId], references: [id])
  user            User      @relation(fields: [userId], references: [id])

  @@unique([challengeId, userId])
}

// ============================================
// DAILY PHRASES
// ============================================

model DailyPhrase {
  id          String   @id @default(cuid())
  phrase      String   // English phrase
  phraseEs    String   // Spanish translation
  context     String   @db.Text // Context of use
  example     String   @db.Text // Example sentence in English
  exampleEs   String   @db.Text // Example sentence in Spanish
  dayOfYear   Int      // 1-366 to cycle through phrases
  category    String   @default("general") // general | travel | food | work | social
  createdAt   DateTime @default(now())
}
